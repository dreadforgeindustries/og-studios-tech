NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional email provider. Resend is recommended for transactional notifications.
RESEND_API_KEY=
BUSINESS_EMAIL=hello@yourdomain.com

# Optional analytics. Leave blank to disable.
NEXT_PUBLIC_ANALYTICS_ID=

# Optional Upstash rate limiting. If omitted, a best-effort in-memory limiter is used per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Used as a fallback when no WhatsApp value is configured in the database.
NEXT_PUBLIC_WHATSAPP_NUMBER=
RESEND_FROM_EMAIL=OG Studios.Tech <noreply@yourdomain.com>
